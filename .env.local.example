# Supabase (public client only for now)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co

# Prefer the new publishable key from Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Or the classic anon/public JWT key (also supported)
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Optional later (server-only; never expose to the browser)
# SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
